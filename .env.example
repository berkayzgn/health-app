# ─── Mobile (Expo) ────────────────────────────────────────────────────────────
# Production build için zorunlu: Render backend URL'si
# Örn: https://health-ai-backend.onrender.com
EXPO_PUBLIC_API_URL=https://your-backend.onrender.com

# ─── Backend (Render ortam değişkenleri — dashboard'dan ayarla) ───────────────

# PostgreSQL bağlantı dizesi (Render PostgreSQL servisi otomatik sağlar)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# JWT imzalama anahtarı — en az 32 karakter, rastgele üret:
#   openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRATION=7d

# Google Gemini API anahtarı (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Tercih edilen Gemini modeli (boş bırakılırsa otomatik seçim)
# GEMINI_MODEL=gemini-2.5-flash-lite

# CORS: mobil uygulama için origin'e gerek yok; web varsa ekle
# Örn: https://app.yourdomain.com,https://admin.yourdomain.com
ALLOWED_ORIGINS=

NODE_ENV=production
PORT=3000
